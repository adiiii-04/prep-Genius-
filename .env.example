# ─────────────────────────────────────────────────────────────────────────────
# SAN — Environment Variables Template
# Copy this file to ".env" and fill in your real values.
# NEVER commit ".env" to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── NVIDIA Nemotron 3.5 (Primary backend for revision notes) ──────────────────
# Get your free key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# Nemotron GENERATIVE model for revision notes (NOT an embedding model)
# Options:
#   nvidia/nemotron-3.5-super-vl-120b-a12b  — most capable (120B MoE)
#   nvidia/nemotron-3.5-lightning-30b-a3b   — faster, lighter (30B MoE)
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# NVIDIA inference API endpoint — works for all NVIDIA catalog models
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Legacy / Fallback (optional — used only if NVIDIA_API_KEY is absent) ──────
# Supports OpenAI, Groq, OpenRouter, Ollama, vLLM, or any OpenAI-compatible API.
OPENAI_API_KEY=your_openai_api_key_here

# Model name (only used when NEMOTRON_MODEL is not set)
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, or any endpoint-compatible model
OPENAI_MODEL=gpt-4o-mini

# (Optional) Custom endpoint base URL. Leave blank to use the NVIDIA default above.
# Examples:
#   http://localhost:11434/v1    — Ollama
#   https://api.groq.com/openai/v1 — Groq
OPENAI_BASE_URL=

# ── Shared summarizer settings ────────────────────────────────────────────────
# Temperature (0.0–1.0). Lower = more precise, less creative. Default 0.2.
OPENAI_TEMPERATURE=0.2

# Notes verbosity: "detailed" (full sections) or "concise" (bullet points only)
SUMMARIZER_FORMAT=detailed


# ── Gemini (Flashcards & Quiz generation) ─────────────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use. Options: gemini-1.5-flash (free), gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# ── Topic Clustering (Sentence-Transformers, runs locally on CPU) ─────────────
# Local embedding model name. Defaults to all-MiniLM-L6-v2 (22 MB, very fast).
# Other options: paraphrase-MiniLM-L3-v2, all-mpnet-base-v2, or any HuggingFace model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Hard upper bound for automatic topic cluster selection (default 8)
MAX_TOPICS=8
